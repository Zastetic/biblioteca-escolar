# Copie este arquivo para `.env` e preencha. O `.env` NÃO é versionado.
# O run.sh carrega o .env automaticamente se ele existir.

# Chave de assinatura da SED SP (portal de integrações).
# Sem ela, o modo SED real não funciona — o modo mock continua.
SED_SUBSCRIPTION_KEY=

# true  = valida RA+senha na API real da SED (Secretaria Digital SP)
# false = modo MOCK, valida contra os alunos seed do banco (funciona offline)
SED_ENABLED=false

# Porta do servidor
PORTA=8123

# Anti-bot Cloudflare Turnstile (opcional). Sem a secret, o login não exige captcha.
# Chaves de teste da Cloudflare (sempre passam): sitekey 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
